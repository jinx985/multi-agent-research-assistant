# Environment variables template
# Copy this file to .env and fill in your actual values

# ============================================================
# 模型 API 配置（支持任意 OpenAI 兼容接口）
# ============================================================

# 1) OpenAI 官方（需科学上网 + 付费）
# OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=            ← 留空即可

# 2) DeepSeek（国内直连，超便宜，推荐！）
# 注册: https://platform.deepseek.com
# OPENAI_API_KEY=sk-your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# 模型名填: deepseek-chat

# 3) 智谱 GLM（有免费模型 glm-4-flash）
# 注册: https://open.bigmodel.cn
# OPENAI_API_KEY=your-zhipu-key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 模型名填: glm-4-flash

# 4) Kimi / Moonshot
# 注册: https://platform.moonshot.cn
# OPENAI_API_KEY=sk-your-kimi-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# 模型名填: moonshot-v1-8k

# 5) Ollama 本地免费跑（无需 Key，需下载模型）
# 安装: https://ollama.com 后执行: ollama pull qwen2.5:7b
# OPENAI_API_KEY=ollama
# OPENAI_BASE_URL=http://localhost:11434/v1
# 模型名填: qwen2.5:7b

# ============================================================
# 当前生效配置（改这里！）
# ============================================================
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 搜索 API（可选）
# Tavily API Key (optional, for better search results)
# Get it at https://tavily.com
TAVILY_API_KEY=

# SerpAPI Key (optional alternative to Tavily)
# Get it at https://serpapi.com
SERPAPI_API_KEY=
